{
  "name": "qr-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QR Studio: generador de QR artísticos y modelos 3D imprimibles. Sitio estático, sin dependencias de npm.",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:exports": "node scripts/verify/run_export_check.mjs",
    "e2e": "node scripts/e2e.mjs"
  }
}
